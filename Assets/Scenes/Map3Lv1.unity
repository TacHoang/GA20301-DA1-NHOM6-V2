MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1704573415}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c04dcf3b5cf34b64c93d0a85e19362a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: TheMagicGirl
  dialogues:
  - "B\u1EA1n l\xE0 m\u1ED9t anh h\u1EEBng tuy\u1EC7t v\u1EDDi!!!!"
  - "Ti\xEAu di\u1EC7t \u0111\u01B0\u1EE3c t\xEAn tr\xF9m th\u1EE9 hai "
  - "T\xEAn \u0111\xF3 r\u1EA5t m\u1EA1nh m\u1EBD"
  - "B\u1EA1n \u0111\u1EBFn \u0111\u01B0\u1EE3c n\u01A1i n\xE0y "
  - "H\xE3y chu\u1EA9n b\u1ECB nh\u1EEFng \u0111i\u1EC1u kh\xF3 kh\u0103n tr\u01B0\u1EDBc
    m\u1EAFt n\xF3 s\u1EBD di\u1EC5n ra ngay"
  - "\u0110\u01B0\u01A1ng nhi\xEAn t\xF4i v\u1EABn s\u1EBD cung c\u1EA5p k\u1EF9
    n\u0103ng th\u1EE9 t\u01B0 cho b\u1EA1n"
  - "Mu\u1ED1n nh\u1EADn \u0111\u01B0\u1EE3c k\u1EF9 n\u0103ng t\u1EEB t\xF4i"
  - "B\u1EA1n h\xE3y ti\xEAu di\u1EC7t 40 con qu\xE1i v\u1EADt!!"
  postQuestDialogues:
  - "S\u1EF1 c\u1ED1 g\u1EAFng c\u1EE7a b\u1EA1n lu\xF4n \u0111\u01B0\u1EE3c \u0111\u1EC1n
    \u0111\xE1p qua t\u1EEBng khu v\u1EF1c"
  - "M\u1ED9t s\u1EF1 c\u1ED1 g\u1EAFng \u0111\u1EA7y mong \u0111\u1EE3i"
  - "B\u1EA1n lu\xF4n \u1EDF m\u1ED9t tr\u1EA1ng th\xE1i t\u1ED1t nh\xE1t \u0111\u1EC3
    ti\xEAu di\u1EC7t qu\xE1i v\u1EADt"
  - "V\xE0 t\xF4i c\u0169ng kh\xF4ng mu\u1ED1n ai ph\u1EA3i kh\xF3 kh\u0103n \u0111\u1EC3
    ti\u1EBFn \u0111\u1EBFn s\u1EF1 b\xECnh y\xEAn"
  - "Cho n\xEAn t\xF4i s\u1EBD gi\xFAp cho b\u1EA1n th\xEAm m\u1ED9t k\u1EF9 n\u0103ng
    m\u1EDBi \u0111\u1EC3 c\xE0ng m\u1EA1nh h\u01A1n n\u1EEFa"
  - "K\u1EF9 n\u0103ng \u0111\xF3 c\xF3 t\xEAn \"Tam th\u1EA1ch\""
  - "C\xE1ch s\u1EED d\u1EE5ng k\u1EF9 n\u0103ng n\xE0y "
  - "B\u1EA5m ph\xEDm 4 \u0111\u1EC3 thi tri\u1EC3n"
  - "V\u1EDBi 10 gi\xE2y h\u1ED3i chi\xEAu v\xE0 m\u1ED7i vi\xEAn th\u1EA1ch nh\u0169
    g\xE2y 70 s\xE1t th\u01B0\u01A1ng"
  - "B\u1EAFn theo m\u1ED9t h\u01B0\u1EDBng th\u1EB3ng"
  - "B\u1EA1n c\xF3 th\u1EC3 s\u1EED d\u1EE5ng k\u1EF9 n\u0103ng n\xE0y khi qua m\xE0n
    m\u1EDBi"
  - "V\xE0........"
  dialogueTextUI: {fileID: 1977372558}
  dialoguePanel: {fileID: 1312240092}
  player: {fileID: 652304907}
  teleportTarget: {fileID: 22512877}
  portal: {fileID: 1297764163}
  watchDistance: 5
  skillManager: {fileID: 1241459546}

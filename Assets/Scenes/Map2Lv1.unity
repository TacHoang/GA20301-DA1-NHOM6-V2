  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c04dcf3b5cf34b64c93d0a85e19362a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: TheMagicGirl
  dialogues:
  - "G\u1EB7p l\u1EA1i b\u1EA1n th\xEAm l\u1EA7n n\u1EEFa r\u1ED3i"
  - "Sau khi nh\u1EADn \u0111\u01B0\u1EE3c k\u1EF9 n\u0103ng b\u1EA1n c\u1EA3m th\u1EA5y
    ra sao?"
  - "C\u1EA3m th\u1EA5y m\u1EA1nh m\u1EBD l\xEAn \u0111\xFAng kh\xF4ng"
  - "\u0110\xE2y l\xE0 khu v\u1EE5c m\u1EDBi s\u1EBD nguy hi\u1EC3m h\u01A1n l\xFAc
    \u1EDF khu v\u1EE5c kia"
  - "N\u1EBFu b\u1EA1n mu\u1ED1n v\u01B0\u1EE3t qua n\u01A1i n\xE0y "
  - "H\xE3y s\u1EED d\u1EE5ng k\u1EF9 n\u0103ng t\xF4i \u0111\xE3 t\u1EB7ng b\u1EA1n
    \u0111\u1EC3 t\u0103ng kh\u1EA3 n\u0103ng ti\xEAu di\u1EC7t qu\xE1i v\u1EADt"
  - "V\u1EADy b\u1EA1n h\xE3y ti\xEAu di\u1EC7t 12 con qu\xE1i v\u1EADt!!"
  postQuestDialogues:
  - "V\u1EABn nh\u01B0 l\xFAc tr\u01B0\u1EDBc c\u1EE7a nh\u1EEFng m\xE0n v\u1EEBa
    qua"
  - "Ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 t\u1ED1t nh\u01B0 m\u1ECDi khi "
  - "R\u1EA5t \u0111\xFAng \u0111\u1EAFn khi tin t\u01B0\u1EDFng b\u1EA1n"
  - "H\xE3y lu\xF4n n\xE2ng cao s\u1EE9c m\u1EA1nh b\u1EA3n th\xE2n \u0111\u1ED1i
    \u0111\u1EA7u v\u1EDBi nh\u1EEFng th\u1EED th\xE1ch \u0111\u1EA7y cam go!!"
  - "V\xE0........"

--- !u!114 &999172585
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 999172584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c04dcf3b5cf34b64c93d0a85e19362a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: TheMagicGirl
  dialogues:
  - "N\u01A1i n\xE0y l\xE0 n\u01A1i th\u1EADt s\u1EF1 nguy hi\u1EC3m c\u1EE7a t\xEAn
    tr\xF9m th\u1EE9 ba "
  - "Nh\u1EEFng t\xEAn tr\xF9m n\xE0y lu\xF4n lu\xF4n kh\xF3 nh\u1EB1n \u0111\u1EC3
    ti\xEAu di\u1EC7t"
  - "H\xE3y c\u1ED1 g\u1EAFng ti\xEAu di\u1EC7t t\xEAn n\xE0y \u0111\u1EC3 \u0111\u1EBFn
    v\u1EDBi th\u1EED th\xE1ch cu\u1ED1i c\xF9ng"
  - "Ti\u1EBFn \u0111\u1EBFn s\u1EF1 b\xECnh y\xEAn cho th\u1EBF gi\u1EDBi n\xE0y "
  - "T\xF4i s\u1EBD h\u1ED7 tr\u1EE3 b\u1EA1n h\u1EBFt m\xECnh v\xE0 v\u1EABn lu\xF4n
    \u0111\u01B0a ph\u1EA7n th\u01B0\u1EDFng cho b\u1EA1n"
  - "L\xE0m nhi\u1EC7m v\u1EE5 t\xF4i giao v\xE0 nh\u1EADn ph\u1EA7n th\u01B0\u1EDFng"
  - "B\u1EA1n h\xE3y ti\xEAu di\u1EC7t 50 con qu\xE1i v\u1EADt!!"
  postQuestDialogues:
  - "M\u1ED9t s\u1EF1 ki\xEAn tr\xEC kh\xF4ng th\u1EC3 ch\u1ED1i c\xE3i \u0111\u01B0\u1EE3c"
  - "S\u1EF1 c\u1ED1 g\u1EAFng c\u1EE7a b\u1EA1n s\u1EBD \u0111\u01B0\u1EE3c \u0111\u1EC1n
    \u0111\xE1p ngay b\xE2y gi\u1EDD"
  - "\u0110\xF3 l\xE0 k\u1EF9 n\u0103ng cu\u1ED1i c\xF9ng"
  - "K\u1EF9 n\u0103ng \"S\u1EF1 tr\u1EDF l\u1EA1i c\u1EE7a th\u1EA7n\""
  - "\u0110\xFAng nh\u01B0 c\xE1i t\xEAn c\u1EE7a k\u1EF9 n\u0103ng \u0111\xF3 "
  - "Khi k\xEDch ho\u1EA1t k\u1EF9 n\u0103ng khi trong v\xF9ng c\u1ED1 \u0111\u1ECBnh
    nh\u1EEFng vi\xEAn thi\xEAn th\u1EA1ch m\u1ED7i vi\xEAn s\u1EBD g\xE2y 20 s\xE1t
    th\u01B0\u01A1ng"
  - "C\xF2n qu\u1EA3 c\u1EA7u si\xEAu m\u1EA1nh m\u1EBD s\u1EBD g\xE2y 200 s\xE1t
    th\u01B0\u01A1ng"
  - "Th\u1EDDi gian h\u1ED3i chi\xEAu cho k\u1EF9 n\u0103ng n\xE0y l\xE0 30 gi\xE2y "
  - "M\u1ED9t k\u1EF9 n\u0103ng m\u1EA1nh m\u1EBD ti\xEAu di\u1EC7t b\u1EA5t c\u1EE9
    con qu\xE1i v\u1EADt n\xE0o \u0111ang trong v\xF9ng k\xEDch ho\u1EA1t chi\xEAu"
  - "Nh\u01B0ng h\xE3y nh\u1EDB khi b\u1EA1n v\u1EEBa b\u01B0\u1EDBc v\xE0o khu v\u1EF1c
    c\u1EE7a t\xEAn m\u1EA1nh nh\u1EA5t \u0111\xE3 chi\u1EBFm gi\u1EEF th\u1EBF gi\u1EDBi
    n\xE0y"
  - "B\u1EA1n s\u1EBD b\u1ECB b\xF3ng t\u1ED1i che m\u1EDD \u0111i t\u1EA7m nh\xECn "
  - "H\xE3y nh\u1EA1y b\xE9n tinh m\u1EAFt \u0111\u1EC3 th\u1EA5y \u0111\u01B0\u1EE3c
    nh\u1EEFng t\xEAn l\xE2u ti\xEAu di\u1EC7t h\u1EBFt"
  - "T\xF4i mong b\u1EA1n s\u1EBD b\xECnh an khi v\xE0o n\u01A1i \u0111\xF3"
  - "T\xF4i s\u1EBD c\xF9ng b\u1EA1n v\xE0o \u0111\xF3 \u0111\u1EC3 xem x\xE9t t\xECnh
    h\xECnh"
  - "C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 l\xE0m t\u1ED1t tr\xE1ch nhi\u1EC7m c\u1EE7a
    v\u1ECB anh h\xF9ng "
  - "V\xE0........................"
  dialogueTextUI: {fileID: 23856224}
  dialoguePanel: {fileID: 1379229959}
  player: {fileID: 1942491404}
  teleportTarget: {fileID: 1658008443}
  portal: {fileID: 1007211925}
  watchDistance: 5
  skillManager: {fileID: 2018978767}
